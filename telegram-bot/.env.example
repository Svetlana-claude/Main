# Образец состава файла настроек бота. Настоящие значения — в
# ~/.config/tgbot/tgbot.env с правами 600; он вне версий и намеренно лежит ВНЕ
# каталога проекта: каталог доступен Claude на чтение из темы проекта.
# Путь задаётся переменной TGBOT_ENV.

# Токен от @BotFather
TELEGRAM_TOKEN=1234567890:AAbbCCddEEffGGhhIIjjKKllMMnnOOppQQ

# Кому можно писать боту — числовые id через запятую. Пустой список = никому.
# Свой id бот показывает командой /id, она отвечает и тем, кого в списке нет.
TELEGRAM_ALLOWED=123456789

# Кому уходят служебные сообщения (чужой стук в бота). Не задан — первый из
# разрешённых.
TELEGRAM_ADMIN=123456789

# Настройки базы и путь к `claude` бот берёт из файла webui
# (~/.config/webui/webui.env): база у них одна, и расходиться им нельзя.
