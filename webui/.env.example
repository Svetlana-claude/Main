# Образец состава файла настроек. Реальные значения — в ~/.config/webui/webui.env
# (права 600), он вне версий и намеренно лежит ВНЕ каталога проекта: каталог
# доступен Claude на чтение из темы проекта. Путь задаётся переменной WEBUI_ENV.
DATABASE_URL=postgresql://webui:ПАРОЛЬ@127.0.0.1:5432/webui
SECRET_KEY=случайные_64_hex_символа
CLAUDE_BIN=/home/mokeeva/.local/bin/claude
REPO_ROOT=/home/mokeeva/main
ROOT_PATH=/Claude
