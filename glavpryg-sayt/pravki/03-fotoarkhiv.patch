+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands;
+
+use App\Models\GalleryItem;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Storage;
+use Orchid\Attachment\Models\Attachment;
+
+/**
+ * Разбор фотоархива: снимки, положенные в папки подразделов напрямую
+ * (по SSH или FTP), становятся слайдами блока «Наши фотографии».
+ *
+ * Файлы остаются лежать на месте — вложение заводится ссылкой на них,
+ * копий не плодится.
+ */
+class FotoArkhivKomanda extends Command
+{
+    protected $signature = 'glavpryg:fotoarkhiv
+                            {--razdel= : только один подраздел (tandem, samostoyatelnyy, sportivnyy, vr)}
+                            {--skrytno : завести слайды выключенными, показать потом вручную}
+                            {--pokazat : ничего не менять, только перечислить находки}';
+
+    protected $description = 'Завести слайды галереи по снимкам из фотоархива';
+
+    /** Что считаем фотографией. */
+    private const RASSHIRENIYA = ['jpg', 'jpeg', 'png', 'webp'];
+
+    public function handle(): int
+    {
+        $disk = Storage::disk('public');
+        $razdely = GalleryItem::razdely();
+
+        if ($odin = $this->option('razdel')) {
+            if (! isset($razdely[$odin])) {
+                $this->error("Неизвестный подраздел «{$odin}». Есть: " . implode(', ', array_keys($razdely)));
+
+                return self::FAILURE;
+            }
+            $razdely = [$odin => $razdely[$odin]];
+        }
+
+        $sort = (int) GalleryItem::max('sort');
+        $zavedeno = 0;
+
+        foreach ($razdely as $razdel => $nazvanie) {
+            $papka = rtrim(GalleryItem::papkaArkhiva($razdel), '/');
+            if (! $disk->exists($papka)) {
+                $disk->makeDirectory($papka);
+            }
+
+            foreach ($disk->files($papka) as $put) {
+                $rasshirenie = strtolower(pathinfo($put, PATHINFO_EXTENSION));
+                if (! in_array($rasshirenie, self::RASSHIRENIYA, true)) {
+                    continue;
+                }
+
+                $imya = pathinfo($put, PATHINFO_FILENAME);
+
+                // Уже заведённое не заводим повторно: признак — вложение,
+                // указывающее ровно на этот файл.
+                $vlozhenie = Attachment::where('disk', 'public')
+                    ->where('path', $papka . '/')
+                    ->where('name', $imya)
+                    ->where('extension', $rasshirenie)
+                    ->first();
+
+                if ($vlozhenie && GalleryItem::where('image_id', $vlozhenie->id)->exists()) {
+                    continue;
+                }
+
+                $this->line("  + {$nazvanie}: {$put}");
+                $zavedeno++;
+
+                if ($this->option('pokazat')) {
+                    continue;
+                }
+
+                $vlozhenie ??= Attachment::create([
+                    'name'          => $imya,
+                    'original_name' => basename($put),
+                    'mime'          => $disk->mimeType($put) ?: 'image/jpeg',
+                    'extension'     => $rasshirenie,
+                    'size'          => $disk->size($put),
+                    'path'          => $papka . '/',
+                    'disk'          => 'public',
+                    'hash'          => md5_file($disk->path($put)),
+                ]);
+
+                GalleryItem::create([
+                    'type'      => GalleryItem::TYPE_PHOTO,
+                    'razdel'    => $razdel,
+                    'image_id'  => $vlozhenie->id,
+                    'is_active' => ! $this->option('skrytno'),
+                    'sort'      => ++$sort,
+                ]);
+            }
+        }
+
+        $this->info($this->option('pokazat')
+            ? "Новых снимков в архиве: {$zavedeno} (ничего не менялось)"
+            : "Заведено слайдов: {$zavedeno}");
+
+        return self::SUCCESS;
+    }
+}
