+<?php
+
+declare(strict_types=1);
+
+namespace App\Orchid\Screens\FotoArkhiv;
+
+use App\Models\GalleryItem;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Orchid\Attachment\Models\Attachment;
+use Orchid\Screen\Actions\Button;
+use Orchid\Screen\Actions\Link;
+use Orchid\Screen\Fields\CheckBox;
+use Orchid\Screen\Fields\Select;
+use Orchid\Screen\Fields\Upload;
+use Orchid\Screen\Screen;
+use Orchid\Support\Facades\Layout;
+use Orchid\Support\Facades\Toast;
+
+/**
+ * Фотоархив сайта: общий склад снимков, разложенный по подразделам.
+ *
+ * Файлы лежат в storage/app/public/fotoarkhiv/<подраздел>/ — каталог переживает
+ * обновление поставки (deploy/obnovit.sh переносит storage/ целиком) и уже
+ * раздаётся через ссылку public/storage. Загруженное отсюда можно сразу
+ * поставить в блок «Наши фотографии» или оставить лежать про запас.
+ */
+class FotoArkhivScreen extends Screen
+{
+    public function name(): ?string
+    {
+        return 'Фотоархив';
+    }
+
+    public function description(): ?string
+    {
+        return 'Склад фотографий сайта по подразделам. Снимки отсюда попадают в блок «Наши фотографии».';
+    }
+
+    public function query(): iterable
+    {
+        return ['papki' => $this->svodka()];
+    }
+
+    /** Сколько файлов лежит в каждой папке архива и сколько из них уже на сайте. */
+    private function svodka(): array
+    {
+        $disk = Storage::disk('public');
+        $vGalereye = GalleryItem::query()
+            ->whereNotNull('razdel')
+            ->selectRaw('razdel, count(*) as vsego, sum(is_active) as vidno')
+            ->groupBy('razdel')
+            ->get()
+            ->keyBy('razdel');
+
+        $svodka = [];
+        foreach (GalleryItem::razdely() as $razdel => $nazvanie) {
+            $papka = GalleryItem::papkaArkhiva($razdel);
+            $svodka[] = [
+                'razdel'    => $razdel,
+                'nazvanie'  => $nazvanie,
+                'papka'     => 'storage/app/public/' . rtrim($papka, '/'),
+                'faylov'    => count($disk->files(rtrim($papka, '/'))),
+                'slaydov'   => (int) ($vGalereye[$razdel]->vsego ?? 0),
+                'vidno'     => (int) ($vGalereye[$razdel]->vidno ?? 0),
+            ];
+        }
+
+        return $svodka;
+    }
+
+    public function commandBar(): iterable
+    {
+        return [
+            Link::make('Блок «Наши фотографии»')
+                ->icon('bs.list-ul')
+                ->route('platform.gallery'),
+        ];
+    }
+
+    public function layout(): iterable
+    {
+        return [
+            Layout::view('admin.fotoarkhiv-svodka'),
+
+            Layout::rows([
+                Select::make('razdel')
+                    ->title('Подраздел')
+                    ->options(GalleryItem::razdely())
+                    ->required()
+                    ->help('Файлы лягут в папку архива с этим именем.'),
+
+                Upload::make('fotki')
+                    ->title('Фотографии')
+                    ->groups('fotoarkhiv')
+                    ->acceptedFiles('image/jpeg,image/png,image/webp')
+                    ->help('Можно сразу несколько. Размер одного файла ограничен настройками хостинга (upload_max_filesize).'),
+
+                CheckBox::make('v_galereyu')
+                    ->title('Сразу в блок «Наши фотографии»')
+                    ->placeholder('Создать слайды и показать на сайте')
+                    ->value(true)
+                    ->sendTrueOrFalse(),
+
+                Button::make('Положить в архив')
+                    ->icon('bs.upload')
+                    ->method('dobavit'),
+            ])->title('Пополнить архив'),
+        ];
+    }
+
+    public function dobavit(Request $request): RedirectResponse
+    {
+        $data = $request->validate([
+            'razdel'     => ['required', Rule::in(array_keys(GalleryItem::razdely()))],
+            'fotki'      => ['required', 'array', 'min:1'],
+            'fotki.*'    => ['integer'],
+            'v_galereyu' => ['nullable', 'boolean'],
+        ], [
+            'fotki.required' => 'Выберите хотя бы одну фотографию.',
+        ]);
+
+        $razdel = $data['razdel'];
+        $papka = GalleryItem::papkaArkhiva($razdel);
+        $disk = Storage::disk('public');
+        $disk->makeDirectory(rtrim($papka, '/'));
+
+        $sort = (int) GalleryItem::max('sort');
+        $polozheno = 0;
+
+        foreach (Attachment::whereIn('id', $data['fotki'])->get() as $vlozhenie) {
+            // Orchid кладёт загруженное в папку по дате и под именем-хэшем.
+            // В архив снимок ложится под человеческим именем: по этим папкам
+            // ходят руками, и «dcb291bc….jpg» в них искать нечем.
+            //
+            // ⚠️ Именно копия, а не перенос. Одинаковые по содержимому снимки
+            // Orchid держит одним файлом на диске — вложения разных загрузок
+            // указывают на него же. Перенос такой файл уводил, и у прежних
+            // вложений оставалась ссылка в пустоту.
+            $bylo = $vlozhenie->physicalPath();
+            if ($bylo !== null && $vlozhenie->path !== $papka && $disk->exists($bylo)) {
+                $imya = $this->svobodnoeImya($vlozhenie->original_name, $papka, $vlozhenie->extension);
+                $disk->copy($bylo, $papka . $imya . '.' . $vlozhenie->extension);
+                $vlozhenie->forceFill(['path' => $papka, 'name' => $imya, 'disk' => 'public'])->save();
+            }
+
+            if ($data['v_galereyu'] ?? false) {
+                GalleryItem::create([
+                    'type'      => GalleryItem::TYPE_PHOTO,
+                    'razdel'    => $razdel,
+                    'image_id'  => $vlozhenie->id,
+                    'is_active' => true,
+                    'sort'      => ++$sort,
+                ]);
+            }
+
+            $polozheno++;
+        }
+
+        Toast::info($polozheno . ' — положено в архив «' . GalleryItem::razdely()[$razdel] . '»');
+
+        return redirect()->route('platform.fotoarkhiv');
+    }
+
+    /**
+     * Имя файла в папке архива: по исходному имени снимка, латиницей и без
+     * пробелов. Занятое имя не затирается — к нему добавляется номер.
+     */
+    private function svobodnoeImya(?string $iskhodnoe, string $papka, string $rasshirenie): string
+    {
+        $disk = Storage::disk('public');
+        $osnova = Str::slug(pathinfo((string) $iskhodnoe, PATHINFO_FILENAME)) ?: 'foto';
+
+        $imya = $osnova;
+        for ($n = 2; $disk->exists($papka . $imya . '.' . $rasshirenie); $n++) {
+            $imya = $osnova . '-' . $n;
+        }
+
+        return $imya;
+    }
+}
