+<?php
+
+declare(strict_types=1);
+
+namespace App\Orchid\Filters;
+
+use App\Models\GalleryItem;
+use Illuminate\Database\Eloquent\Builder;
+use Orchid\Filters\Filter;
+use Orchid\Screen\Fields\Select;
+
+/**
+ * Отбор слайдов галереи по подразделу — тандем, самостоятельный, спортивный, VR.
+ */
+class RazdelGaleriiFilter extends Filter
+{
+    public function name(): string
+    {
+        return 'Подраздел';
+    }
+
+    public function parameters(): array
+    {
+        return ['razdel'];
+    }
+
+    public function run(Builder $builder): Builder
+    {
+        return $builder->where('razdel', $this->request->get('razdel'));
+    }
+
+    public function display(): array
+    {
+        return [
+            Select::make('razdel')
+                ->options(GalleryItem::razdely())
+                ->empty('Все подразделы')
+                ->value($this->request->get('razdel'))
+                ->title('Подраздел'),
+        ];
+    }
+
+    public function value(): string
+    {
+        $razdel = (string) $this->request->get('razdel');
+
+        return $this->name() . ': ' . (GalleryItem::razdely()[$razdel] ?? $razdel);
+    }
+}
