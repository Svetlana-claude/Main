+/**
+ * Починка адресов загрузки файлов в админке, когда сайт живёт в подпути.
+ *
+ * Orchid собирает адреса своих служебных запросов (загрузка файла, удаление
+ * вложения, поиск) не маршрутом Laravel, а вручную — из имени хоста и метки
+ * `dashboard-prefix`:
+ *
+ *     `${location.protocol}//${location.hostname}${prefix.content}${path}`
+ *
+ * В метке лежит `platform.prefix`, то есть «/admin». Сайт же выложен по адресу
+ * mokeevasky.ru/glavpryg, и подпуть в этой склейке теряется: загрузка уходила
+ * на `/admin/systems/files` вместо `/glavpryg/admin/systems/files` и получала
+ * 404. Ломались все поля загрузки разом — и Picture, и Upload, и картинки
+ * в текстовом редакторе.
+ *
+ * Правка подставляет в метку настоящий путь админки, взятый из адреса самой
+ * открытой страницы. Orchid читает метку в момент запроса, а не при загрузке
+ * страницы, поэтому поправить её заранее достаточно.
+ */
+(function () {
+    function popravit() {
+        var metka = document.head.querySelector('meta[name="dashboard-prefix"]');
+        if (!metka) {
+            return;
+        }
+
+        var prefiks = metka.getAttribute('content') || '';
+        var put = window.location.pathname;
+        if (prefiks === '' || put.indexOf(prefiks) === 0) {
+            return;             // сайт в корне домена — поправлять нечего
+        }
+
+        // Путь админской страницы — «<подпуть><префикс>/…»: всё, что стоит
+        // до префикса, и есть потерянный подпуть.
+        var mesto = put.indexOf(prefiks + '/');
+        if (mesto < 0 && put.slice(-prefiks.length) === prefiks) {
+            mesto = put.length - prefiks.length;
+        }
+        if (mesto > 0) {
+            metka.setAttribute('content', put.slice(0, mesto) + prefiks);
+        }
+    }
+
+    popravit();
+    // Turbo подменяет содержимое головы при переходе — поправку надо повторять.
+    document.addEventListener('turbo:load', popravit);
+})();
