+<?php
+
+namespace App\Support;
+
+use Orchid\Support\Facades\Dashboard;
+
+/**
+ * Пути админки — полные, от корня домена.
+ *
+ * Зачем нужен отдельный помощник. `Dashboard::prefix()` отдаёт префикс
+ * **маршрута** — «/admin». Этого достаточно, пока сайт живёт в корне домена,
+ * и мало, когда он выложен в подкаталог: наш стоит по адресу
+ * `mokeevasky.ru/glavpryg`, и путь админской страницы — «/glavpryg/admin».
+ *
+ * Разница была бы безобидной, если бы Orchid не собирал адреса своих
+ * служебных запросов вручную, склейкой строк (`application_controller.js`):
+ *
+ *     location.protocol + '//' + location.hostname + метка + путь
+ *
+ * В метку `dashboard-prefix` макет Orchid кладёт префикс маршрута, подкаталог
+ * в склейку не попадает — и запрос на загрузку файла уходил на
+ * `mokeevasky.ru/admin/systems/files` вместо `/glavpryg/admin/systems/files`.
+ * Отваливались все поля загрузки разом, и молча.
+ *
+ * ⚠️ Менять ради этого `config('platform.prefix')` нельзя: тот же ключ
+ * Orchid берёт префиксом при **регистрации** маршрутов
+ * (`RouteServiceProvider`), и адреса стали бы «/glavpryg/glavpryg/admin».
+ * Поправить нужно именно метку, а префикс маршрута оставить как есть.
+ *
+ * Путь не вычисляется из `location.pathname` и не прописывается руками:
+ * его считает штатный генератор адресов Laravel, который про подкаталог
+ * знает. Поэтому на своём домене, в корне или в другом подкаталоге правка
+ * останется верной без настройки.
+ */
+class Adminka
+{
+    /**
+     * Путь админки от корня домена: «/glavpryg/admin» или «/admin» в корне.
+     */
+    public static function put(string $put = ''): string
+    {
+        return parse_url(url(Dashboard::prefix($put)), PHP_URL_PATH) ?: Dashboard::prefix($put);
+    }
+}
