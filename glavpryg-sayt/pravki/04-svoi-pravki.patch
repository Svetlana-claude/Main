+<?php
+
+namespace App\Support;
+
+/**
+ * Проверка, что картинка вправду лежит в `public/`.
+ *
+ * Зачем. Страница VR-тренажёра ссылается на тринадцать рисунков, а в поставке
+ * пришли только четыре: `images/vr/ris-5.jpg` … `ris-13.jpg` не было вовсе.
+ * Девять ответов 404 на одной странице, в вёрстке — значок битой картинки, и
+ * у посетителя страница выглядит недоделанной.
+ *
+ * Рисунки не вырезаны из разметки нарочно: подписи и порядок — часть
+ * технического разбора тренажёра, и когда снимки найдутся, их достаточно будет
+ * положить в папку. Поэтому блок рисунка показывается только при живом файле:
+ * нет файла — нет и блока, страница собирается целиком и без 404.
+ *
+ * ⚠️ Проверяется именно файл на диске, а не ответ сервера: `asset()` соберёт
+ * адрес и для несуществующего файла, об этом узнает только браузер.
+ */
+class Kartinka
+{
+    /**
+     * Есть ли такой файл в `public/`. Путь — как в `asset()`, без ведущего слеша.
+     */
+    public static function est(string $put): bool
+    {
+        return is_file(public_path(ltrim($put, '/')));
+    }
+
+    /**
+     * Есть ли хоть одна из картинок.
+     *
+     * Нужна для блоков-сеток: если спрятать по отдельности все рисунки сетки,
+     * от неё останется пустой блок с внешним отступом — лишняя полоса пустоты
+     * на странице. Условие на саму сетку это убирает, но сетка вернётся, как
+     * только найдётся хотя бы один её рисунок.
+     */
+    public static function estLyubaya(array $puti): bool
+    {
+        foreach ($puti as $put) {
+            if (self::est($put)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
