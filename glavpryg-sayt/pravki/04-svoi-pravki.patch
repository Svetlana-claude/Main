+<?php
+
+namespace App\Support;
+
+use App\Models\Setting;
+
+/**
+ * Контакты сайта — из настроек админки, одним источником.
+ *
+ * Зачем. В поставке телефон, адрес и часы работы были вписаны прямо в
+ * разметку — `tel:+74956789999` в шапке, в мобильном меню, на странице
+ * контактов, в подвале. Настройка «Телефон в шапке» при этом существовала и
+ * доходила ровно до одной страницы. Заказчик меняет номер в админке, видит на
+ * сайте прежний и решает, что админка не работает.
+ *
+ * Хуже того, данные расходились между собой: страница контактов показывала
+ * «дер. Большое Грызлово», а в настройках лежал «Аэродром Финам», часы —
+ * «с 8:00 до 20:00» против «Пн–Вс 8:00–22:00».
+ *
+ * ⚠️ Запасные значения здесь — не выдумка, а тот самый текст, который стоял в
+ * шаблонах и был на сайте. В настройках лежали заготовки разработчика (почта
+ * была `info@namedomain.ru`), поэтому настоящее содержимое перенесено из
+ * разметки в настройки, а не наоборот: на вид страница не изменилась, но
+ * теперь ею правит админка. Запасные значения остаются на случай, если поле
+ * настройки окажется пустым — страница не должна показывать пустоту.
+ */
+class Kontakty
+{
+    private const ZAPASNOY_TELEFON = '+7 (495) 678 99 99';
+    private const ZAPASNAYA_POCHTA = 'info@glavpryg.ru';
+    private const ZAPASNOY_ADRES = '142290, Россия, Московская обл., Серпуховский р-он, дер. Большое Грызлово';
+    private const ZAPASNYE_CHASY = 'Ежедневно c 8:00 до 20:00';
+
+    /** Телефон в шапке — как его показывать человеку. */
+    public static function telefon(): string
+    {
+        return Setting::current()->phone_header ?: self::ZAPASNOY_TELEFON;
+    }
+
+    /** Телефон в подвале: своя настройка, а нет её — тот же, что в шапке. */
+    public static function telefonPodvala(): string
+    {
+        return Setting::current()->phone_footer ?: self::telefon();
+    }
+
+    /**
+     * Ссылка для звонка из показываемого номера.
+     *
+     * ⚠️ Из номера выбрасывается всё, кроме цифр: `tel:` с пробелами и
+     * скобками часть телефонов набирает неверно. Ведущая «8» заменяется на
+     * «+7» — иначе звонок из-за границы не уходит.
+     */
+    public static function tel(?string $nomer = null): string
+    {
+        $cifry = preg_replace('/\D+/', '', $nomer ?? self::telefon());
+
+        if (str_starts_with((string) $cifry, '8') && strlen((string) $cifry) === 11) {
+            $cifry = '7' . substr((string) $cifry, 1);
+        }
+
+        return 'tel:+' . $cifry;
+    }
+
+    public static function pochta(): string
+    {
+        return Setting::current()->email ?: self::ZAPASNAYA_POCHTA;
+    }
+
+    public static function adres(): string
+    {
+        return Setting::current()->address ?: self::ZAPASNOY_ADRES;
+    }
+
+    public static function chasy(): string
+    {
+        return Setting::current()->work_hours ?: self::ZAPASNYE_CHASY;
+    }
+
+    /**
+     * Ссылка на мессенджер или соцсеть, если она заведена в настройках.
+     *
+     * Кнопки Telegram и Max стояли в вёрстке с мёртвым `href="#"`. Пустая
+     * настройка означает «кнопку не показывать»: ссылка в никуда хуже, чем
+     * отсутствие кнопки.
+     *
+     * ⚠️ Одинокая решётка считается пустотой. Именно она лежала в настройках
+     * заготовкой (`social_tg = '#'`), и показывать по ней кнопку — то же
+     * самое, что показывать её по мёртвому `href="#"` из разметки.
+     */
+    public static function set(string $klyuch): ?string
+    {
+        $znachenie = trim((string) (Setting::current()->{'social_' . $klyuch} ?? ''));
+
+        return $znachenie !== '' && $znachenie !== '#' ? $znachenie : null;
+    }
+}
