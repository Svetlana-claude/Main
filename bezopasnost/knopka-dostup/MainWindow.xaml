<Window x:Class="KnopkaDostup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кнопка доступа к ноуту" Width="560" Height="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Доступ к моему ноуту" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"
                   Text="Включает обратный туннель ноут → ваш сервер. Пока кнопка нажата, вы можете зайти на ноут со своего устройства через сервер. Закрыли окно — доступа нет."/>

        <!-- Настройки -->
        <GroupBox Grid.Row="2" Header="Куда подключаться" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbHost" Margin="0,4" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Порт:" VerticalAlignment="Center" Margin="12,4,8,4"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="TbPort" Margin="0,4" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Учётка:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbUser" Margin="0,4" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Туннель:" VerticalAlignment="Center" Margin="12,4,8,4"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TbFwd" Margin="0,4" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ключ:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbKey" Margin="0,4" VerticalContentAlignment="Center"/>
                <Button    Grid.Row="2" Grid.Column="3" x:Name="BtnKey" Content="Выбрать…" Margin="0,4" Click="BtnKey_Click"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="known_hosts:" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbKnown" Margin="0,4" VerticalContentAlignment="Center"/>
                <Button    Grid.Row="3" Grid.Column="3" x:Name="BtnKnown" Content="Выбрать…" Margin="0,4" Click="BtnKnown_Click"/>
            </Grid>
        </GroupBox>

        <!-- Кнопка и статус -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnToggle" Content="Открыть доступ" Width="180" Height="44" FontSize="15"
                    FontWeight="SemiBold" Click="BtnToggle_Click"/>
            <Ellipse x:Name="Lamp" Width="14" Height="14" Fill="#BBB" Margin="16,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TbStatus" Text="Выключено" VerticalAlignment="Center" Foreground="#555"/>
        </StackPanel>

        <GroupBox Grid.Row="4" Header="Журнал" Padding="4">
            <TextBox x:Name="TbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="#FAFAFA"/>
        </GroupBox>
    </Grid>
</Window>
